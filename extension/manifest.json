{
  "manifest_version": 3,
  "name": "SomeDay",
  "short_name": "SomeDay",
  "version": "0.4.8",
  "description": "Add places from Google Maps, then plan your trip",
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" },
  "action": {
    "default_title": "SomeDay: click to turn on",
    "default_icon": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://chewei00.github.io/SomeDay/*"],
  "content_scripts": [
    {
      "matches": ["https://www.google.com/maps/*", "https://www.google.com.tw/maps/*"],
      "js": ["maps.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chewei00.github.io/SomeDay/*"],
      "js": ["site.js"],
      "run_at": "document_start"
    }
  ]
}
